#7. Create an array with first 8 multiples of 6 and compute the sum, mean, maximum and minimum value of the array 

import numpy as np
arr = np.array([6,12,18,24,30,36,42,48])
print("Multiples of 6:", arr)
tot = sum(arr)
mean = sum(arr)//len(arr)
maximum = max(arr)
minimum = min(arr)
print("Sum of array:", tot)
print("Mean of array:", mean)
print("Maximum value in the array:", maximum)
print("Minimum value in the array:", minimum)

